{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "secrets": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    },
    "shared_accounts": {
      ".read": false,
      "$nodeId": {
        ".read": "$nodeId.beginsWith('link_') || auth != null",
        ".write": "$nodeId.beginsWith('link_') ? (auth != null && (data.exists() ? data.child('ownerUid').val() === auth.uid : newData.child('ownerUid').val() === auth.uid)) : (auth != null)"
      }
    },
    "numericIds": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "sharedBundles": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "inboxByNumericId": {
      ".read": "auth != null",
      ".write": "auth != null"
    }
  }
}
